[Unit]
Description=ACTUVa Django (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/actuva
EnvironmentFile=/opt/actuva/.env
ExecStart=/opt/actuva/venv/bin/gunicorn actuva.wsgi:application -c /opt/actuva/deploy/gunicorn.conf.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
